rules_version = '2';

// OptimaByte Firestore rules.
//
//   content/{doc}   public read, admin write   (editable site content, e.g. portfolio images)
//   reports/{id}    public create (validated + rate limited), admin read/update/delete
//   adminLogins/{id} admin only: the latest 5 admin sign-ins (device + location)
//   limits/{key}    rate-limit counters: public get/create/update (validated), admin list/delete
//   invoices/{id}, invoicePdfs/{id}, invoiceClients/{id}, invoiceSettings/main
//                   admin only (validated): invoices, their stored PDFs, saved clients, invoice settings
//
// The admin is the single Firebase Auth user admin@optimabyte.com.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'admin@optimabyte.com';
    }

    function shortStr(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }

    // ---------------------------------------------------------------- content
    match /content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------- reports
    function validReport(id) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'name', 'email', 'phone', 'service', 'message', 'createdAt', 'deviceId',
          'fingerprint', 'status', 'source'
        ])
        && d.keys().hasAll([
          'name', 'email', 'phone', 'service', 'message', 'createdAt', 'deviceId',
          'fingerprint', 'status', 'source'
        ])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 80
        && d.email is string && d.email.size() <= 120
        && d.email.matches('^[^@\\s/|]+@[^@\\s/|]+\\.[^@\\s/|]+$')
        && shortStr(d.phone, 30)
        && d['service'] is string && d['service'].size() >= 2 && d['service'].size() <= 80
        && d.message is string && d.message.size() >= 10 && d.message.size() <= 2000
        && d.createdAt == request.time
        && d.deviceId is string && d.deviceId.size() >= 16 && d.deviceId.size() <= 64
        && d.fingerprint is string && d.fingerprint.size() >= 16 && d.fingerprint.size() <= 64
        && d.status == 'pending'
        && d.source == 'contact-form'
        // The same batch must also bump all three counters for THIS report.
        && getAfter(/databases/$(database)/documents/limits/$('e_' + d.email.lower())).data.lastReportId == id
        && getAfter(/databases/$(database)/documents/limits/$('d_' + d.deviceId)).data.lastReportId == id
        && getAfter(/databases/$(database)/documents/limits/$('f_' + d.fingerprint)).data.lastReportId == id;
    }

    match /reports/{reportId} {
      allow create: if validReport(reportId);
      allow read, delete: if isAdmin();
      // Admins may change the status only.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['pending', 'in_progress', 'completed'];
    }

    // --------------------------------------------------------------- invoices
    // Everything below is admin only. Nothing here is readable or writable by visitors.
    function optStr(d, k, maxLen) {
      return !(k in d) || shortStr(d[k], maxLen);
    }

    function isoDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function money(v) {
      return v is number && v >= 0 && v <= 1000000000;
    }

    // Billing details copied onto an invoice (and the fields of a saved client).
    function clientFieldsOk(c) {
      return shortStr(c.name, 120) && c.name.size() >= 1
        && shortStr(c.email, 120)
        && shortStr(c.phone, 30)
        && shortStr(c.address, 160)
        && shortStr(c.kraPin, 20);
    }

    function invoiceClientOk(c) {
      return c is map
        && c.keys().hasOnly(['name', 'email', 'phone', 'address', 'kraPin'])
        && c.keys().hasAll(['name', 'email', 'phone', 'address', 'kraPin'])
        && clientFieldsOk(c);
    }

    function validNewInvoice() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'number', 'clientId', 'client', 'issueDate', 'dueDate', 'items', 'discount',
          'vatRate', 'notes', 'terms', 'paymentDetails', 'subtotal', 'vat', 'total',
          'payments', 'voided', 'pdfSize', 'createdAt'
        ])
        && d.keys().hasAll([
          'number', 'clientId', 'client', 'issueDate', 'dueDate', 'items', 'discount',
          'vatRate', 'notes', 'terms', 'paymentDetails', 'subtotal', 'vat', 'total',
          'payments', 'voided', 'pdfSize', 'createdAt'
        ])
        && shortStr(d.number, 40) && d.number.size() >= 1
        && shortStr(d.clientId, 64)
        && invoiceClientOk(d.client)
        && isoDate(d.issueDate) && isoDate(d.dueDate) && d.dueDate >= d.issueDate
        && d['items'] is list && d['items'].size() >= 1 && d['items'].size() <= 100
        && money(d.discount) && money(d.subtotal) && money(d.vat) && money(d.total)
        && d.vatRate is number && d.vatRate >= 0 && d.vatRate <= 100
        && shortStr(d.notes, 5000) && shortStr(d.terms, 5000) && shortStr(d.paymentDetails, 5000)
        && d.payments is list && d.payments.size() <= 50
        && d.voided == false
        && d.pdfSize == 0
        && d.createdAt == request.time;
    }

    match /invoices/{invoiceId} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin() && validNewInvoice();
      // An invoice may be created with payments already received. After creation only payments, the void flag and the stored PDF size may change.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payments', 'voided', 'pdfSize'])
        && request.resource.data.payments is list && request.resource.data.payments.size() <= 200
        && request.resource.data.voided is bool
        && request.resource.data.pdfSize is int
        && request.resource.data.pdfSize >= 0 && request.resource.data.pdfSize <= 1000000;
    }

    // The generated PDF, stored as base64 so the invoice list stays light.
    // A PDF always starts with "%PDF", which is "JVBER" in base64. Firestore caps a
    // document at 1 MiB, and the app refuses anything above 900,000 characters.
    function validPdfDoc() {
      let d = request.resource.data;
      return d.keys().hasOnly(['data', 'updatedAt'])
        && d.keys().hasAll(['data', 'updatedAt'])
        && d['data'] is string
        && d['data'].size() >= 100
        && d['data'].size() <= 900000
        && d['data'].matches('JVBER.*')
        && d['updatedAt'] == request.time;
    }

    match /invoicePdfs/{invoiceId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && validPdfDoc();
    }

    match /invoiceClients/{clientId} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'address', 'kraPin', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'email', 'phone', 'address', 'kraPin', 'createdAt'])
        && clientFieldsOk(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'phone', 'address', 'kraPin'])
        && clientFieldsOk(request.resource.data);
    }

    // One document, "main". Written with merge, so a field may be missing the very
    // first time (the number counter creates it); every field present is checked.
    function validSettings() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'businessName', 'address', 'email', 'phone', 'kraPin', 'prefix', 'nextNumber',
          'dueDays', 'vatRate', 'paymentDetails', 'terms', 'footer'
        ])
        && optStr(d, 'businessName', 120)
        && optStr(d, 'address', 160)
        && optStr(d, 'email', 120)
        && optStr(d, 'phone', 40)
        && optStr(d, 'kraPin', 20)
        && optStr(d, 'prefix', 12)
        && (!('nextNumber' in d) || (d.nextNumber is int && d.nextNumber >= 1 && d.nextNumber <= 100000000))
        && (!('dueDays' in d) || (d.dueDays is number && d.dueDays >= 0 && d.dueDays <= 365))
        && (!('vatRate' in d) || (d.vatRate is number && d.vatRate >= 0 && d.vatRate <= 100))
        && optStr(d, 'paymentDetails', 2000)
        && optStr(d, 'terms', 3000)
        && optStr(d, 'footer', 200);
    }

    match /invoiceSettings/{settingsId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && settingsId == 'main' && validSettings();
    }

    // ------------------------------------------------------------ adminLogins
    match /adminLogins/{id} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin() && request.resource.data.at == request.time;
      allow update: if false;
    }

    // ----------------------------------------------------------------- limits
    // Counter keys: e_<email>, d_<device id>, f_<fingerprint>. Each counter allows
    // 3 writes per rolling hour (12 for the shared fingerprint) and can only be
    // written together with a real report that matches the key.
    function limitShapeOk(key) {
      let d = request.resource.data;
      let isE = key.matches('e_.*');
      let isD = key.matches('d_.*');
      let isF = key.matches('f_.*');
      let cap = isF ? 12 : 3;
      return d.keys().hasOnly(['count', 'windowStart', 'lastReportId'])
        && d.count is int && d.count >= 1 && d.count <= cap
        && d.windowStart is timestamp
        && d.lastReportId is string
        && existsAfter(/databases/$(database)/documents/reports/$(d.lastReportId))
        && (
          isE
            ? key == 'e_' + getAfter(/databases/$(database)/documents/reports/$(d.lastReportId)).data.email.lower()
            : isD
              ? key == 'd_' + getAfter(/databases/$(database)/documents/reports/$(d.lastReportId)).data.deviceId
              : isF
                ? key == 'f_' + getAfter(/databases/$(database)/documents/reports/$(d.lastReportId)).data.fingerprint
                : false
        );
    }

    match /limits/{key} {
      // Visitors may read only their own counter by exact id (needed to show a
      // friendly "limit reached" message). It holds no personal data.
      allow get: if true;
      allow list, delete: if isAdmin();

      allow create: if limitShapeOk(key)
        && request.resource.data.count == 1
        && request.resource.data.windowStart == request.time;

      allow update: if limitShapeOk(key)
        && (
          resource.data.windowStart + duration.value(1, 'h') <= request.time
            // Window over: restart at 1.
            ? (request.resource.data.count == 1
                && request.resource.data.windowStart == request.time)
            // Window open: exactly one more, same window start.
            : (request.resource.data.count == resource.data.count + 1
                && request.resource.data.windowStart == resource.data.windowStart)
        );
    }
  }
}
