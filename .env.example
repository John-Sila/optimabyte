# Copy this file to .env.local and fill in the values from
# Firebase console > Project settings > General > Your apps > Web app > SDK setup and configuration.
# The same variables must be added in Vercel: Project > Settings > Environment Variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional, extra bot protection (Firebase App Check with reCAPTCHA v3). See FIREBASE_SETUP.md, step 9.
VITE_RECAPTCHA_SITE_KEY=

# URL of your Cloudflare Worker (email notifications + login location). See cloudflare/worker/README.md.
# Leave empty to run without those two features.
VITE_WORKER_URL=
